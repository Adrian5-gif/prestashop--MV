# Variables de configuración que usan todos los scripts

# ----- Dominio y HTTPS -----
DOMAIN=adrianrios-prestashop.duckdns.org
LE_EMAIL=adrian5@iesalbarregas.es

# ----- Base de datos de PrestaShop -----
PS_DB_NAME=prestashop
PS_DB_USER=ps_user
PS_DB_PASSWORD=ps_password

# ----- Usuario de phpMyAdmin -----
PMA_USER=pma_admin
PMA_PASSWORD=pma_password

# ----- PrestaShop -----
# Enlace de descarga de la última versión (PrestaShop Classic)
PS_URL=file:///vagrant/prestashop_9.2.1.zip
PS_SHOP_NAME="Tienda de Adrian"
PS_ADMIN_EMAIL=adrian5@iesalbarregas.es
PS_ADMIN_PASSWORD=Adrian.Tienda2026
PS_ADMIN_FOLDER=admin_adrian
PS_LANGUAGE=es
PS_COUNTRY=es

# El token de DuckDNS NO se sube a GitHub: se lee del fichero duckdns_token.txt
DUCKDNS_TOKEN=$(cat /vagrant/scripts/duckdns_token.txt 2>/dev/null | tr -d '[:space:]')
